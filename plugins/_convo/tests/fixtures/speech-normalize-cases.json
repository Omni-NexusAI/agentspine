{
  "about": "Speech output normalization, shared by tests/test_speech_providers.py (helpers/speech_providers.normalize) and tests/speech-ui.test.mjs (webui/speech-catalog.js normalizeTts), so the server and the browser derive the same fields. Each input is merged over the default roles.tts; expect lists every field normalization may touch (null = the field is absent).",
  "paths": ["provider", "connection", "backend", "url", "instructions", "capabilities.instruction_control", "capabilities.native_pcm", "provider_saved"],
  "cases": [
    {"name": "an older openai configuration is left exactly as it is",
     "input": {"backend": "openai", "url": "http://127.0.0.1:8881/v1", "model": "qwen3-tts", "voice": "clone:abc", "capabilities": {"native_pcm": true}},
     "expect": {"provider": "", "connection": "", "backend": "openai", "url": "http://127.0.0.1:8881/v1", "instructions": null, "capabilities.instruction_control": null, "capabilities.native_pcm": true, "provider_saved": null}},
    {"name": "an older managed configuration stays managed",
     "input": {"backend": "managed_audio", "model": "base-f16", "voice": "clone:one"},
     "expect": {"provider": "", "connection": "", "backend": "managed_audio", "url": "http://convo-audio:8080/v1", "instructions": null, "capabilities.instruction_control": null, "capabilities.native_pcm": null, "provider_saved": null}},
    {"name": "an older Kokoro configuration is not touched, even a flag Kokoro ignores",
     "input": {"backend": "host_kokoro", "capabilities": {"native_pcm": true}},
     "expect": {"provider": "", "connection": "", "backend": "host_kokoro", "url": "http://convo-audio:8080/v1", "instructions": null, "capabilities.instruction_control": null, "capabilities.native_pcm": true, "provider_saved": null}},
    {"name": "an older configuration's hand-set flag counts as its declaration",
     "input": {"backend": "openai", "url": "http://127.0.0.1:9000/v1", "model": "tts-x", "voice": "nova", "instructions": "warm", "capabilities": {"instruction_control": true}},
     "expect": {"provider": "", "connection": "", "backend": "openai", "url": "http://127.0.0.1:9000/v1", "instructions": "warm", "capabilities.instruction_control": true, "capabilities.native_pcm": null, "provider_saved": null}},
    {"name": "but not with a clone voice: the text waits in the stash of the provider it means",
     "input": {"backend": "openai", "url": "http://127.0.0.1:9000/v1", "model": "tts-x", "voice": "clone:abc", "instructions": "warm", "capabilities": {"instruction_control": true}},
     "expect": {"provider": "", "connection": "", "backend": "openai", "url": "http://127.0.0.1:9000/v1", "instructions": "", "capabilities.instruction_control": null, "capabilities.native_pcm": null, "provider_saved": {"openai_compatible": {"instructions": "warm"}}}},
    {"name": "an older managed configuration never sends instructions",
     "input": {"backend": "managed_audio", "instructions": "softly"},
     "expect": {"provider": "", "connection": "", "backend": "managed_audio", "url": "http://convo-audio:8080/v1", "instructions": "", "capabilities.instruction_control": null, "capabilities.native_pcm": null, "provider_saved": {"audiocpp": {"managed": {"instructions": "softly"}}}}},
    {"name": "Kokoro chosen explicitly derives its backend and owns nothing else",
     "input": {"provider": "kokoro_native", "backend": "openai", "instructions": "warm", "capabilities": {"native_pcm": true}},
     "expect": {"provider": "kokoro_native", "connection": "", "backend": "host_kokoro", "url": "http://convo-audio:8080/v1", "instructions": "warm", "capabilities.instruction_control": null, "capabilities.native_pcm": null, "provider_saved": null}},
    {"name": "audio.cpp without a connection is an external server at its default address",
     "input": {"provider": "audiocpp", "url": ""},
     "expect": {"provider": "audiocpp", "connection": "external", "backend": "openai", "url": "http://host.docker.internal:8890/v1", "instructions": null, "capabilities.instruction_control": null, "capabilities.native_pcm": null, "provider_saved": null}},
    {"name": "audio.cpp managed by Convo speaks through the managed runtime and never takes instructions",
     "input": {"provider": "audiocpp", "connection": "managed", "backend": "openai", "instructions": "softly", "capabilities": {"native_pcm": true}},
     "expect": {"provider": "audiocpp", "connection": "managed", "backend": "managed_audio", "url": "http://convo-audio:8080/v1", "instructions": "", "capabilities.instruction_control": null, "capabilities.native_pcm": true, "provider_saved": {"audiocpp": {"managed": {"instructions": "softly"}}}}},
    {"name": "an external audio.cpp Base model ignores a declaration",
     "input": {"provider": "audiocpp", "connection": "external", "url": "http://host.docker.internal:8890/v1", "model": "qwen3-tts-1.7b-base-bf16", "voice": "clone:2098c329bc9d", "accepts_instructions": true, "instructions": "calm"},
     "expect": {"provider": "audiocpp", "connection": "external", "backend": "openai", "url": "http://host.docker.internal:8890/v1", "instructions": "", "capabilities.instruction_control": null, "capabilities.native_pcm": null, "provider_saved": {"audiocpp": {"external": {"instructions": "calm"}}}}},
    {"name": "an external audio.cpp model that is not a clone honours a declaration",
     "input": {"provider": "audiocpp", "connection": "external", "url": "http://host.docker.internal:8890/v1", "model": "qwen3-tts-1.7b-customvoice", "voice": "vivian", "accepts_instructions": true, "instructions": "calm", "capabilities": {"native_pcm": true}},
     "expect": {"provider": "audiocpp", "connection": "external", "backend": "openai", "url": "http://host.docker.internal:8890/v1", "instructions": "calm", "capabilities.instruction_control": true, "capabilities.native_pcm": true, "provider_saved": null}},
    {"name": "without the declaration the text waits under its connection",
     "input": {"provider": "audiocpp", "connection": "external", "model": "qwen3-tts-1.7b-customvoice", "voice": "vivian", "instructions": "calm"},
     "expect": {"provider": "audiocpp", "connection": "external", "backend": "openai", "url": "http://convo-audio:8080/v1", "instructions": "", "capabilities.instruction_control": null, "capabilities.native_pcm": null, "provider_saved": {"audiocpp": {"external": {"instructions": "calm"}}}}},
    {"name": "waiting text sits beside an older flat audio.cpp record",
     "input": {"provider": "audiocpp", "connection": "external", "url": "http://host.docker.internal:8890/v1", "model": "qwen3-tts-1.7b-base-bf16", "voice": "clone:x", "instructions": "calm", "provider_saved": {"audiocpp": {"connection": "managed", "voice": "clone:m"}}},
     "expect": {"provider": "audiocpp", "connection": "external", "backend": "openai", "url": "http://host.docker.internal:8890/v1", "instructions": "", "capabilities.instruction_control": null, "capabilities.native_pcm": null, "provider_saved": {"audiocpp": {"connection": "managed", "voice": "clone:m", "external": {"instructions": "calm"}}}}},
    {"name": "llama.cpp gets its default address, no PCM, and a declaration is honoured",
     "input": {"provider": "llamacpp", "url": "", "model": "orpheus-3b", "voice": "tara", "accepts_instructions": true, "instructions": "excited", "capabilities": {"native_pcm": true}},
     "expect": {"provider": "llamacpp", "connection": "", "backend": "openai", "url": "http://host.docker.internal:8080/v1", "instructions": "excited", "capabilities.instruction_control": true, "capabilities.native_pcm": null, "provider_saved": null}},
    {"name": "Unsloth Studio has no documented default address",
     "input": {"provider": "unsloth_studio", "url": ""},
     "expect": {"provider": "unsloth_studio", "connection": "", "backend": "openai", "url": "", "instructions": null, "capabilities.instruction_control": null, "capabilities.native_pcm": null, "provider_saved": null}},
    {"name": "OpenAI gpt-4o-mini-tts honours instructions, has its own address and no PCM",
     "input": {"provider": "openai_tts", "url": "", "model": "gpt-4o-mini-tts", "voice": "coral", "remote": true, "instructions": "warm", "capabilities": {"native_pcm": true}},
     "expect": {"provider": "openai_tts", "connection": "", "backend": "openai", "url": "https://api.openai.com/v1", "instructions": "warm", "capabilities.instruction_control": true, "capabilities.native_pcm": null, "provider_saved": null}},
    {"name": "OpenAI tts-1 does not: the text waits",
     "input": {"provider": "openai_tts", "url": "https://api.openai.com/v1", "model": "tts-1", "voice": "alloy", "remote": true, "instructions": "warm"},
     "expect": {"provider": "openai_tts", "connection": "", "backend": "openai", "url": "https://api.openai.com/v1", "instructions": "", "capabilities.instruction_control": null, "capabilities.native_pcm": null, "provider_saved": {"openai_tts": {"instructions": "warm"}}}},
    {"name": "back on gpt-4o-mini-tts the waiting text returns",
     "input": {"provider": "openai_tts", "url": "https://api.openai.com/v1", "model": "gpt-4o-mini-tts", "voice": "alloy", "remote": true, "instructions": "", "provider_saved": {"openai_tts": {"instructions": "warm"}}},
     "expect": {"provider": "openai_tts", "connection": "", "backend": "openai", "url": "https://api.openai.com/v1", "instructions": "warm", "capabilities.instruction_control": true, "capabilities.native_pcm": null, "provider_saved": null}},
    {"name": "a dated gpt-4o-mini-tts snapshot is the same model",
     "input": {"provider": "openai_tts", "url": "https://api.openai.com/v1", "model": "gpt-4o-mini-tts-2025-12-15", "voice": "marin", "remote": true, "instructions": "warm"},
     "expect": {"provider": "openai_tts", "connection": "", "backend": "openai", "url": "https://api.openai.com/v1", "instructions": "warm", "capabilities.instruction_control": true, "capabilities.native_pcm": null, "provider_saved": null}},
    {"name": "a leftover connection on a provider without connections is cleared",
     "input": {"provider": "openai_tts", "connection": "managed", "url": "https://api.openai.com/v1", "model": "tts-1", "voice": "nova", "remote": true},
     "expect": {"provider": "openai_tts", "connection": "", "backend": "openai", "url": "https://api.openai.com/v1", "instructions": null, "capabilities.instruction_control": null, "capabilities.native_pcm": null, "provider_saved": null}},
    {"name": "a generic endpoint with a clone voice ignores its declaration",
     "input": {"provider": "openai_compatible", "url": "http://127.0.0.1:8881/v1", "model": "qwen3-tts", "voice": "clone:16d9bb336799", "accepts_instructions": true, "instructions": "calm", "capabilities": {"native_pcm": true}},
     "expect": {"provider": "openai_compatible", "connection": "", "backend": "openai", "url": "http://127.0.0.1:8881/v1", "instructions": "", "capabilities.instruction_control": null, "capabilities.native_pcm": true, "provider_saved": {"openai_compatible": {"instructions": "calm"}}}},
    {"name": "the text in use wins over an older waiting one",
     "input": {"provider": "openai_compatible", "url": "http://127.0.0.1:8881/v1", "model": "kokoro-82m", "voice": "af_bella", "accepts_instructions": true, "instructions": "new", "provider_saved": {"openai_compatible": {"instructions": "old", "model": "x"}}},
     "expect": {"provider": "openai_compatible", "connection": "", "backend": "openai", "url": "http://127.0.0.1:8881/v1", "instructions": "new", "capabilities.instruction_control": true, "capabilities.native_pcm": null, "provider_saved": {"openai_compatible": {"model": "x"}}}},
    {"name": "with nothing in use and something waiting, unsupported text keeps waiting",
     "input": {"provider": "openai_compatible", "url": "http://127.0.0.1:8881/v1", "model": "m", "voice": "v", "instructions": "", "provider_saved": {"openai_compatible": {"instructions": "old"}}},
     "expect": {"provider": "openai_compatible", "connection": "", "backend": "openai", "url": "http://127.0.0.1:8881/v1", "instructions": "", "capabilities.instruction_control": null, "capabilities.native_pcm": null, "provider_saved": {"openai_compatible": {"instructions": "old"}}}},
    {"name": "once a provider is chosen a hand-set flag is not a declaration",
     "input": {"provider": "openai_compatible", "url": "http://127.0.0.1:8881/v1", "model": "m", "voice": "v", "instructions": "warm", "capabilities": {"instruction_control": true}},
     "expect": {"provider": "openai_compatible", "connection": "", "backend": "openai", "url": "http://127.0.0.1:8881/v1", "instructions": "", "capabilities.instruction_control": null, "capabilities.native_pcm": null, "provider_saved": {"openai_compatible": {"instructions": "warm"}}}}
  ]
}
