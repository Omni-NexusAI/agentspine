    {
      "name": "a piece that continues its line keeps a dash",
      "in": " - Jupiter has faint ones.",
      "line_start": false,
      "out": " - Jupiter has faint ones."
    },
    {
      "name": "a piece that continues its line has no heading",
      "in": " # 1 was a hit",
      "line_start": false,
      "out": " # 1 was a hit"
    },
    {
      "name": "a piece that continues its line still loses emphasis",
      "in": "**Saturn** too.",
      "line_start": false,
      "out": "Saturn too."
    },
    {
      "name": "a line that begins inside a piece is still a line",
      "in": " rings.\n- Jupiter",
      "line_start": false,
      "out": " rings.\nJupiter"
    },
    {
      "name": "empty",
      "in": "",
      "out": ""
    }
  ]
}
